---
# Target is `production`. The role is not there yet: `ansible-lint --profile production` reports
# no-changed-when (docker compose / maintenance commands), risky-shell-pipe, no-relative-paths and
# risky-file-permissions. Fixing them changes handler notification behaviour, so each needs its own change and test.
profile: basic

# Exclude files not meant to be linted directly
exclude_paths:
  - .github/
  - molecule/shared/vars.yml   # a vars file, not a playbook

# Skip rules that don't apply to this role
skip_list:
  - yaml[truthy]          # boolean style is a matter of preference
  - var-naming[pattern]   # role intentionally uses UPPER_CASE variable names (breaking to rename)
